## Model Debugging

### Token Usage Tracking
```python
# Track token usage
class TokenTracker:
    def __init__(self):
        self.total_input_tokens = 0
        self.total_output_tokens = 0

    def track_tokens(self, response):
        if hasattr(response, 'usage_metadata'):
            self.total_input_tokens += response.usage_metadata.get('input_tokens', 0)
            self.total_output_tokens += response.usage_metadata.get('output_tokens', 0)

        print(f"Total input tokens: {self.total_input_tokens}")
        print(f"Total output tokens: {self.total_output_tokens}")

tracker = TokenTracker()

# Use with model calls
response = chat_model.invoke(prompt)
tracker.track_tokens(response)
```

### Response Quality Analysis
```python
# Analyze response patterns
def analyze_response(question: str, context: list, response: str):
    print(f"Question: {question}")
    print(f"Context documents: {len(context)}")
    print(f"Response length: {len(response)} chars")

    # Check for "I don't know" responses
    unknown_responses = ["i don't know", "i do not know", "unknown", "not sure"]
    is_unknown = any(phrase in response.lower() for phrase in unknown_responses)
    print(f"Unknown response: {is_unknown}")

    # Check context usage
    context_text = " ".join([doc.page_content for doc in context])
    context_overlap = len(set(response.lower().split()) & set(context_text.lower().split()))
    print(f"Context word overlap: {context_overlap}")

    return {
        "question": question,
        "response_length": len(response),
        "is_unknown": is_unknown,
        "context_overlap": context_overlap,
        "context_docs": len(context)
    }
```

## Error Handling Debugging

### Comprehensive Error Catching
```python
def robust_node(node_func):
    def wrapper(state: State) -> State:
        try:
            result = node_func(state)
            print(f"✅ {node_func.__name__} succeeded")
            return result
        except Exception as e:
            print(f"❌ {node_func.__name__} failed: {e}")
            print(f"State keys: {list(state.keys())}")
            print(f"Error type: {type(e).__name__}")

            # Return safe fallback
            return {"error": str(e)}

    return wrapper

# Apply to nodes
@robust_node
def safe_retrieve(state: State) -> State:
    # ... implementation
    pass
```

### Service Health Monitoring
```python
import requests
from datetime import datetime

def check_all_services():
    services = {
        "Ollama": "http://localhost:11434/api/tags",
        "Qdrant": "http://localhost:6333/collections"
    }

    status = {}
    for name, url in services.items():
        try:
            response = requests.get(url, timeout=5)
            status[name] = {
                "status": "✅ Running",
                "response_time": response.elapsed.total_seconds(),
                "status_code": response.status_code
            }
        except Exception as e:
            status[name] = {
                "status": f"❌ Error: {e}",
                "response_time": None,
                "status_code": None
            }

    print(f"Service check at {datetime.now()}")
    for name, info in status.items():
        print(f"{name}: {info['status']}")
        if info['response_time']:
            print(f"  Response time: {info['response_time']:.3f}s")

    return status

# Regular health checks
health_status = check_all_services()
```

## Advanced Optimization

### Async Processing
```python
import asyncio
from typing import List

async def async_batch_process(queries: List[str]):
    """Process multiple queries asynchronously"""

    async def process_single(query: str):
        # Simulate async processing
        await asyncio.sleep(0.1)
        return graph.invoke({"question": query})

    # Process in parallel
    tasks = [process_single(q) for q in queries]
    results = await asyncio.gather(*tasks)

    return results

# Usage
# results = asyncio.run(async_batch_process(["query1", "query2", "query3"]))
```

### Caching Strategies
```python
from functools import lru_cache
import hashlib

# Cache embeddings
@lru_cache(maxsize=1000)
def cached_embed_query(query: str):
    return tuple(embedding_model.embed_query(query))

# Cache retrieval results
retrieval_cache = {}

def cached_retrieve(query: str, k: int = 5):
    cache_key = hashlib.md5(f"{query}_{k}".encode()).hexdigest()

    if cache_key in retrieval_cache:
        print(f"Cache hit for: {query[:50]}...")
        return retrieval_cache[cache_key]

    result = retriever.invoke(query)
    retrieval_cache[cache_key] = result
    print(f"Cache miss for: {query[:50]}...")

    return result
```

